cp internal/inventory/inventory.go \
  internal/inventory/inventory.go.before-agent-schema-fix
  
python3 <<'PY'
from pathlib import Path

path = Path("internal/inventory/inventory.go")
text = path.read_text(encoding="utf-8")

old_uuid = '''\
		AgentUUID: firstStringAt(m,
			[]string{"agent_uuid"}, []string{"machine_uuid"}, []string{"identity", "uuid"}, []string{"host", "uuid"}, []string{"system", "uuid"}, []string{"identity", "machine_id"}),'''

new_uuid = '''\
		AgentUUID: firstStringAt(m,
			[]string{"host", "correlation_uuid"},
			[]string{"host", "correlation", "primary"},
			[]string{"host", "product_uuid"},
			[]string{"host", "machine_id"},
			[]string{"agent_uuid"},
			[]string{"machine_uuid"},
			[]string{"identity", "uuid"},
			[]string{"host", "uuid"},
			[]string{"system", "uuid"},
			[]string{"identity", "machine_id"}),'''

old_collectors = '''\
	if collectors := firstValueAt(m,
		[]string{"collectors"}, []string{"collector_status"}, []string{"status", "collectors"}, []string{"meta", "collectors"}); collectors != nil {'''

new_collectors = '''\
	if collectors := firstValueAt(m,
		[]string{"collection", "collectors"},
		[]string{"collectors"},
		[]string{"collector_status"},
		[]string{"status", "collectors"},
		[]string{"meta", "collectors"}); collectors != nil {'''

if old_uuid not in text:
    raise SystemExit("Blocul AgentUUID nu a fost găsit; fișierul poate fi deja modificat.")

if old_collectors not in text:
    raise SystemExit("Blocul collectors nu a fost găsit; fișierul poate fi deja modificat.")

text = text.replace(old_uuid, new_uuid, 1)
text = text.replace(old_collectors, new_collectors, 1)

path.write_text(text, encoding="utf-8")
print("Modificările au fost aplicate.")
PY






