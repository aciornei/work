sudo mysqldump \
  --single-transaction \
  --routines \
  --triggers \
  vm_doc \
  > /root/vm_doc-before-0.2.0.sql
  
  
  sudo mysqldump -u root -p \
  --single-transaction \
  --routines \
  --triggers \
  vm_doc \
  > /root/vm_doc-before-0.2.0.sql
  
  
  sudo cp -a /etc/vm-doc-server \
  /etc/vm-doc-server.backup-0.1.0
  
  sudo cp -a /opt/vm-doc-server/bin \
  /opt/vm-doc-server/bin.backup-0.1.0
  
  
  sudo systemctl stop vm-doc-collector
sudo systemctl stop vm-doc-server


sudo install -m 0755 \
  bin/vm-doc-server \
  /opt/vm-doc-server/bin/vm-doc-server
  
  sudo install -m 0755 \
  bin/vm-doc-collector \
  /opt/vm-doc-server/bin/vm-doc-collector
  
  
  grep -n '^vcenter:' /etc/vm-doc-server/config.yaml
  
  sudo nano /etc/vm-doc-server/config.yaml
  vcenter:
  allow_http: false
  request_timeout: "60s"
  detail_workers: 8
  scheduler_interval: "1m"
  
  sudo systemctl start vm-doc-server
  
  sudo journalctl -u vm-doc-server -n 100 --no-pager
  curl -i http://127.0.0.1:9080/readyz
  
  sudo systemctl start vm-doc-collector
  
  
  sudo systemctl status vm-doc-server --no-pager
sudo systemctl status vm-doc-collector --no-pager
