cat > tools/decrypt-secrets/main.go <<'EOF'
package main

import (
	"flag"
	"fmt"
	"os"
	"strings"

	"vm-doc-server/internal/cryptox"
)

func main() {
	in := flag.String("in", "", "encrypted input")
	out := flag.String("out", "", "plaintext output")
	keyFile := flag.String("key", "", "master key file")
	flag.Parse()

	if *in == "" || *out == "" || *keyFile == "" {
		fmt.Fprintln(os.Stderr, "-in, -out and -key are required")
		os.Exit(1)
	}

	ciphertext, err := os.ReadFile(*in)
	check(err)

	master, err := os.ReadFile(*keyFile)
	check(err)

	box, err := cryptox.New(master)
	check(err)

	plain, err := box.Decrypt(
		strings.TrimSpace(string(ciphertext)),
		"vm-doc-secrets",
	)
	check(err)

	check(os.WriteFile(*out, plain, 0600))
	fmt.Println(*out)
}

func check(err error) {
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
EOF
