from pathlib import Path

changes = {
    "internal/vcenter/vms.go": [
        ("var out []domain.VirtualMachine",
         "out := make([]domain.VirtualMachine, 0)")
    ],
    "internal/vcenter/service.go": [
        ("var out []domain.VCenterSource",
         "out := make([]domain.VCenterSource, 0)"),
        ("var runs []domain.VCenterSyncRun",
         "runs := make([]domain.VCenterSyncRun, 0)"),
        ("var out []domain.VCenterSyncRun",
         "out := make([]domain.VCenterSyncRun, 0)")
    ],
}

for filename, replacements in changes.items():
    path = Path(filename)
    text = path.read_text()

    for old, new in replacements:
        if old not in text:
            print(f"ATENȚIE: nu am găsit în {filename}: {old}")
            continue
        text = text.replace(old, new, 1)

    path.write_text(text)
    print(f"actualizat: {filename}")
PY
