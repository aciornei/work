TS=$(date +%Y%m%d-%H%M%S)

sudo mkdir -p "/opt/vm-doc-server/backup/$TS"

sudo cp -a /opt/vm-doc-server/bin/vm-doc-server \
  "/opt/vm-doc-server/backup/$TS/"

sudo cp -a /opt/vm-doc-server/bin/vm-doc-collector \
  "/opt/vm-doc-server/backup/$TS/"

sudo cp -a /opt/vm-doc-server/config \
  "/opt/vm-doc-server/backup/$TS/" 2>/dev/null || true

echo "Backup creat în /opt/vm-doc-server/backup/$TS"
ls -lah "/opt/vm-doc-server/backup/$TS"
