#!/usr/bin/env python3

import shutil
import stat
import sys
import tempfile
import time
import zipfile

from datetime import datetime
from pathlib import Path, PurePosixPath


# ===================================================================
# CONFIGURARE
# ===================================================================

# Directorul în care sunt depuse arhivele ZIP.
IN_DIR = Path("/data/zip/incoming")

# Directorul în care vor fi mutate arhivele ZIP curățate.
OUT_DIR = Path("/data/zip/clean")

# Directorul pentru arhive corupte, criptate sau periculoase.
QUARANTINE_DIR = Path("/data/zip/quarantine")

# Fișierul ZIP trebuie să nu fi fost modificat în ultimele secunde.
# Se evită astfel procesarea unui ZIP care încă se copiază.
MIN_FILE_AGE_SECONDS = 120

# Extensiile permise în interiorul arhivei.
# Se scriu cu litere mici și cu punct.
ALLOWED_EXTENSIONS = {
    ".pdf",

    ".doc",
    ".docx",

    ".xls",
    ".xlsx",

    ".ppt",
    ".pptx",

    ".txt",
    ".csv",
    ".rtf",

    ".xml",
    ".json",

    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".bmp",
    ".tif",
    ".tiff",

    ".eml",
}

# Dacă este False, fișierele fără extensie vor fi eliminate.
ALLOW_FILES_WITHOUT_EXTENSION = False

# Protecție împotriva arhivelor de tip ZIP bomb.
MAX_FILES = 100_000

# Dimensiunea totală maximă a fișierelor după dezarhivare.
MAX_TOTAL_UNCOMPRESSED_SIZE = 10 * 1024 * 1024 * 1024  # 10 GB

# Dimensiunea maximă permisă pentru un singur fișier.
MAX_SINGLE_FILE_SIZE = 2 * 1024 * 1024 * 1024  # 2 GB

# Raport maxim între dimensiunea necomprimată și cea comprimată.
MAX_COMPRESSION_RATIO = 1000


# ===================================================================
# FUNCȚII
# ===================================================================

def log(message: str) -> None:
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"{timestamp} {message}", flush=True)


def unique_destination(directory: Path, filename: str) -> Path:
    """
    Generează o destinație unică pentru a nu suprascrie un fișier
    deja existent.
    """

    destination = directory / filename

    if not destination.exists():
        return destination

    source_name = Path(filename)
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")

    counter = 1

    while True:
        destination = directory / (
            f"{source_name.stem}_{timestamp}_{counter}"
            f"{source_name.suffix}"
        )

        if not destination.exists():
            return destination

        counter += 1


def validate_member_name(name: str) -> str:
    """
    Verifică numele și calea fișierului din interiorul arhivei.

    Blochează exemple precum:
      ../../etc/passwd
      /etc/passwd
      C:/Windows/file.exe
    """

    if not name:
        raise ValueError("Arhiva conține un nume de fișier gol")

    if "\x00" in name:
        raise ValueError(
            f"Numele fișierului conține caracter NULL: {name!r}"
        )

    normalized_name = name.replace("\\", "/")

    if normalized_name.startswith("/"):
        raise ValueError(
            f"Cale absolută nepermisă în arhivă: {name}"
        )

    path = PurePosixPath(normalized_name)

    if ".." in path.parts:
        raise ValueError(
            f"Traversare de directoare detectată: {name}"
        )

    if path.parts and ":" in path.parts[0]:
        raise ValueError(
            f"Cale Windows absolută detectată: {name}"
        )

    return normalized_name


def is_symlink(info: zipfile.ZipInfo) -> bool:
    """
    Verifică dacă intrarea ZIP reprezintă un symbolic link.
    """

    mode = info.external_attr >> 16
    return stat.S_ISLNK(mode)


def is_allowed(filename: str) -> bool:
    """
    Verifică extensia fișierului folosind lista ALLOWED_EXTENSIONS.

    Verificarea nu ține cont de litere mari sau mici.
    Funcționează și pentru extensii compuse, dacă sunt adăugate
    în listă, de exemplu '.tar.gz'.
    """

    lowercase_name = filename.lower()

    basename = PurePosixPath(lowercase_name).name

    if not basename:
        return True

    if "." not in basename or basename.startswith(".") and basename.count(".") == 1:
        return ALLOW_FILES_WITHOUT_EXTENSION

    return any(
        lowercase_name.endswith(extension.lower())
        for extension in ALLOWED_EXTENSIONS
    )


def check_archive_limits(entries: list[zipfile.ZipInfo]) -> None:
    """
    Aplică limite pentru protecția împotriva arhivelor ZIP bomb.
    """

    if len(entries) > MAX_FILES:
        raise ValueError(
            f"Arhiva conține prea multe intrări: "
            f"{len(entries)}; limita este {MAX_FILES}"
        )

    total_uncompressed_size = 0

    for entry in entries:
        if entry.is_dir():
            continue

        if entry.file_size > MAX_SINGLE_FILE_SIZE:
            raise ValueError(
                f"Fișierul {entry.filename!r} este prea mare: "
                f"{entry.file_size} bytes"
            )

        total_uncompressed_size += entry.file_size

        if total_uncompressed_size > MAX_TOTAL_UNCOMPRESSED_SIZE:
            raise ValueError(
                "Dimensiunea totală necomprimată a arhivei "
                "depășește limita permisă"
            )

        if entry.file_size > 0:
            if entry.compress_size == 0:
                raise ValueError(
                    f"Raport de compresie suspect pentru "
                    f"{entry.filename!r}"
                )

            compression_ratio = (
                entry.file_size / entry.compress_size
            )

            if compression_ratio > MAX_COMPRESSION_RATIO:
                raise ValueError(
                    f"Raport de compresie suspect pentru "
                    f"{entry.filename!r}: "
                    f"{compression_ratio:.2f}"
                )


def create_clean_info(
    original: zipfile.ZipInfo,
    normalized_name: str,
) -> zipfile.ZipInfo:
    """
    Creează informațiile pentru fișierul care va fi scris în
    noua arhivă.
    """

    clean_info = zipfile.ZipInfo(
        filename=normalized_name,
        date_time=original.date_time,
    )

    clean_info.comment = original.comment
    clean_info.internal_attr = original.internal_attr
    clean_info.external_attr = original.external_attr
    clean_info.create_system = original.create_system

    # Toate fișierele sunt recompresate folosind DEFLATE.
    clean_info.compress_type = zipfile.ZIP_DEFLATED

    return clean_info


def quarantine(source: Path, reason: str) -> None:
    """
    Mută arhiva problematică în directorul de carantină.
    """

    destination = unique_destination(
        QUARANTINE_DIR,
        source.name,
    )

    try:
        shutil.move(str(source), str(destination))

        log(
            f"[QUARANTINE] {source.name}: {reason}; "
            f"mutat în {destination}"
        )

    except Exception as error:
        log(
            f"[EROARE] Nu am putut muta {source} "
            f"în carantină: {error}"
        )


def process_zip(source: Path) -> None:
    """
    Procesează o singură arhivă ZIP.
    """

    temporary_output: Path | None = None
    removed_files: list[str] = []
    kept_files: list[str] = []

    try:
        with zipfile.ZipFile(source, mode="r") as input_zip:
            entries = input_zip.infolist()

            check_archive_limits(entries)

            # Testează integritatea arhivei.
            corrupted_file = input_zip.testzip()

            if corrupted_file is not None:
                raise zipfile.BadZipFile(
                    f"Fișier corupt în arhivă: {corrupted_file}"
                )

            with tempfile.NamedTemporaryFile(
                prefix=f".{source.stem}.",
                suffix=".zip.tmp",
                dir=OUT_DIR,
                delete=False,
            ) as temporary_file:
                temporary_output = Path(temporary_file.name)

            with zipfile.ZipFile(
                temporary_output,
                mode="w",
                compression=zipfile.ZIP_DEFLATED,
                allowZip64=True,
            ) as output_zip:

                for entry in entries:
                    normalized_name = validate_member_name(
                        entry.filename
                    )

                    # Directorul este păstrat.
                    if entry.is_dir():
                        clean_info = create_clean_info(
                            entry,
                            normalized_name,
                        )

                        output_zip.writestr(clean_info, b"")
                        continue

                    # Symlink-urile sunt eliminate.
                    if is_symlink(entry):
                        removed_files.append(
                            f"{normalized_name} [symlink]"
                        )
                        continue

                    # Fișierele care nu sunt în allowlist sunt eliminate.
                    if not is_allowed(normalized_name):
                        removed_files.append(
                            f"{normalized_name} "
                            "[extensie nepermisă]"
                        )
                        continue

                    clean_info = create_clean_info(
                        entry,
                        normalized_name,
                    )

                    # Copiere în flux, fără încărcarea completă
                    # a fișierului în memorie.
                    with input_zip.open(
                        entry,
                        mode="r",
                    ) as source_file:

                        with output_zip.open(
                            clean_info,
                            mode="w",
                            force_zip64=True,
                        ) as destination_file:

                            shutil.copyfileobj(
                                source_file,
                                destination_file,
                                length=1024 * 1024,
                            )

                    kept_files.append(normalized_name)

        destination = unique_destination(
            OUT_DIR,
            source.name,
        )

        # Mutare atomică a arhivei temporare în numele final.
        temporary_output.replace(destination)
        temporary_output = None

        # Originalul se șterge numai după ce arhiva curățată
        # a fost creată cu succes.
        source.unlink()

        log(
            f"[OK] {source.name} -> {destination}; "
            f"păstrate={len(kept_files)}, "
            f"eliminate={len(removed_files)}"
        )

        for removed_file in removed_files:
            log(f"[ELIMINAT] {removed_file}")

    except (
        zipfile.BadZipFile,
        zipfile.LargeZipFile,
        RuntimeError,
        OSError,
        ValueError,
        NotImplementedError,
    ) as error:

        if temporary_output is not None:
            try:
                temporary_output.unlink(missing_ok=True)
            except OSError:
                pass

        quarantine(source, str(error))

    except Exception as error:
        if temporary_output is not None:
            try:
                temporary_output.unlink(missing_ok=True)
            except OSError:
                pass

        log(
            f"[EROARE] Eroare neașteptată pentru "
            f"{source}: {error}"
        )

        quarantine(
            source,
            f"Eroare neașteptată: {error}",
        )


def main() -> int:
    """
    Procesează toate arhivele ZIP suficient de vechi din IN_DIR.
    """

    for directory in (
        IN_DIR,
        OUT_DIR,
        QUARANTINE_DIR,
    ):
        directory.mkdir(
            parents=True,
            exist_ok=True,
        )

    current_time = time.time()

    try:
        files = sorted(IN_DIR.iterdir())
    except OSError as error:
        log(
            f"[EROARE] Nu pot citi directorul "
            f"{IN_DIR}: {error}"
        )
        return 1

    processed_files = 0

    for source in files:
        if not source.is_file():
            continue

        if source.suffix.lower() != ".zip":
            continue

        try:
            file_age = current_time - source.stat().st_mtime
        except FileNotFoundError:
            continue
        except OSError as error:
            log(
                f"[EROARE] Nu pot verifica fișierul "
                f"{source}: {error}"
            )
            continue

        if file_age < MIN_FILE_AGE_SECONDS:
            log(
                f"[WAIT] {source.name} are doar "
                f"{int(file_age)} secunde; poate fi încă "
                "în curs de copiere"
            )
            continue

        log(f"[START] Procesez {source}")
        process_zip(source)
        processed_files += 1

    if processed_files == 0:
        log("[INFO] Nu există arhive ZIP de procesat")

    return 0


if __name__ == "__main__":
    sys.exit(main())
