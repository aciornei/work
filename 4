Import-Module ActiveDirectory

$DomainDN = (Get-ADDomain).DistinguishedName
$OutputFile = "C:\Temp\structura_ad_completa.txt"

function Get-ADTree {
    param (
        [string]$SearchBase,
        [int]$Level = 0
    )

    $Indent = "    " * $Level

    $Users = Get-ADUser `
        -SearchBase $SearchBase `
        -SearchScope OneLevel `
        -Filter * |
        Sort-Object Name

    foreach ($User in $Users) {
        "$Indent    [U] $($User.Name)" |
            Out-File $OutputFile -Append -Encoding UTF8
    }

    $Groups = Get-ADGroup `
        -SearchBase $SearchBase `
        -SearchScope OneLevel `
        -Filter * |
        Sort-Object Name

    foreach ($Group in $Groups) {
        "$Indent    [G] $($Group.Name)" |
            Out-File $OutputFile -Append -Encoding UTF8
    }

    $Computers = Get-ADComputer `
        -SearchBase $SearchBase `
        -SearchScope OneLevel `
        -Filter * |
        Sort-Object Name

    foreach ($Computer in $Computers) {
        "$Indent    [C] $($Computer.Name)" |
            Out-File $OutputFile -Append -Encoding UTF8
    }

    $OUs = Get-ADOrganizationalUnit `
        -SearchBase $SearchBase `
        -SearchScope OneLevel `
        -Filter * |
        Sort-Object Name

    foreach ($OU in $OUs) {
        "$Indent├── [OU] $($OU.Name)" |
            Out-File $OutputFile -Append -Encoding UTF8

        Get-ADTree `
            -SearchBase $OU.DistinguishedName `
            -Level ($Level + 1)
    }
}

Remove-Item $OutputFile -ErrorAction SilentlyContinue

"Active Directory: $((Get-ADDomain).DNSRoot)" |
    Out-File $OutputFile -Encoding UTF8

"" | Out-File $OutputFile -Append

Get-ADTree -SearchBase $DomainDN

Write-Host "Export finalizat: $OutputFile"
