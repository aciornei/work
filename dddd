mysql vm_doc -e "
SELECT
  vm.id AS vm_id,
  vm.name,
  vm.agent_id,
  vm.current_inventory_id,
  a.current_inventory_id AS agent_inventory_id,
  a.agent_uuid,
  a.last_contact_at,
  a.last_success_at,
  a.last_error
FROM virtual_machines vm
LEFT JOIN agents a ON a.id=vm.agent_id
WHERE vm.agent_id IS NOT NULL;
"

mysql vm_doc -e "
SELECT COLUMN_NAME
FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA='vm_doc'
  AND TABLE_NAME='inventory_snapshots'
  AND COLUMN_NAME IN (
    'agent_version',
    'fqdn',
    'product_uuid',
    'product_uuid_legacy',
    'machine_id'
  )
ORDER BY COLUMN_NAME;
"



cd /usr/local/src/vm-doc-server-0.2.2

systemctl stop vm-doc-collector vm-doc-server

mysql vm_doc < migrations/008_vcenter_inventory.up.sql

systemctl start vm-doc-server
systemctl start vm-doc-collector





AGENT_ID=$(mysql -NBe "
USE vm_doc;
SELECT agent_id
FROM virtual_machines
WHERE agent_id IS NOT NULL
ORDER BY id
LIMIT 1;
")

echo "$AGENT_ID"



mysql vm_doc -e "
SELECT
 i.id,
 i.agent_id,
 i.collection_job_id,
 i.schema_version,
 i.agent_uuid,
 i.agent_version,
 i.hostname,
 i.fqdn,
 i.product_uuid,
 i.product_uuid_legacy,
 i.machine_id,
 i.os_name,
 i.os_version,
 i.primary_ip,
 i.boot_time,
 i.collector_total,
 i.collector_ok,
 i.collector_error,
 i.collector_timeout,
 i.payload_size,
 i.payload_sha256,
 i.changed_from_previous,
 i.collected_at,
 i.received_at
FROM inventory_snapshots i
WHERE i.agent_id=${AGENT_ID}
ORDER BY i.id DESC
LIMIT 5;
"



