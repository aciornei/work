Import-Module ActiveDirectory

$DomainDN = (Get-ADDomain).DistinguishedName
$OutputFile = "C:\Temp\structura_ad.txt"

function Get-OUTree {
    param (
        [string]$SearchBase,
        [int]$Level = 0
    )

    $OUs = Get-ADOrganizationalUnit `
        -SearchBase $SearchBase `
        -SearchScope OneLevel `
        -Filter * |
        Sort-Object Name

    foreach ($OU in $OUs) {
        $Indent = "    " * $Level
        "$Indent├── $($OU.Name)" | Out-File $OutputFile -Append -Encoding UTF8

        Get-OUTree `
            -SearchBase $OU.DistinguishedName `
            -Level ($Level + 1)
    }
}

Remove-Item $OutputFile -ErrorAction SilentlyContinue

"Active Directory: $((Get-ADDomain).DNSRoot)" |
    Out-File $OutputFile -Encoding UTF8

Get-OUTree -SearchBase $DomainDN

Write-Host "Structura a fost exportată în $OutputFile"
