from pathlib import Path

path = Path("web/static/js/app.js")
text = path.read_text()

old = """const results=await Promise.all(requests);state.vms=results[0];state.sources=results[1];const runs=results[2];"""

new = """const results=await Promise.all(requests);
  state.vms=Array.isArray(results[0])?results[0]:[];
  state.sources=Array.isArray(results[1])?results[1]:[];
  const runs=Array.isArray(results[2])?results[2]:[];"""

if old not in text:
    raise SystemExit("Linia căutată nu a fost găsită. Nu am modificat fișierul.")

path.write_text(text.replace(old, new))
print("app.js reparat")
