export GOPROXY=off
export GOSUMDB=off
export GOFLAGS=-mod=vendor

go env GOPROXY GOSUMDB GOFLAGS

grep -n 'HandleFunc("GET /' internal/server/server.go

sed -i \
  's#mux.HandleFunc("GET /",#mux.HandleFunc("GET /{$}",#' \
  internal/server/server.go
  
  
  grep -n -C 3 'var out \[\]domain.Agent\|make(\[\]domain.Agent' \
  internal/agents/agents.go
  
  sed -i \
  's/var out \[\]domain\.Agent/out := make([]domain.Agent, 0)/' \
  internal/agents/agents.go
  
  grep -n 'make(\[\]domain.Agent' internal/agents/agents.go
  
  grep -n "state.agents=" web/static/js/app.js
  
  state.agents=await api('/api/v1/agents');
  
  sed -i \
  "s#state.agents=await api('/api/v1/agents');#state.agents=(await api('/api/v1/agents'))||[];#" \
  web/static/js/app.js
  
  
  grep -n "state.agents=" web/static/js/app.js
  
  gofmt -w \
  internal/server/server.go \
  internal/agents/agents.go
  
  go test ./...
  
  mkdir -p bin
  
  CGO_ENABLED=0 \
GOOS=linux \
GOARCH=amd64 \
go build \
  -mod=vendor \
  -trimpath \
  -ldflags="-s -w" \
  -o bin/vm-doc-server \
  ./cmd/vm-doc-server
  
  file bin/vm-doc-server
ldd bin/vm-doc-server

sudo systemctl stop vm-doc-server

sudo cp -a \
  /opt/vm-doc-server/bin/vm-doc-server \
  /opt/vm-doc-server/bin/vm-doc-server.backup-$(date +%Y%m%d-%H%M%S)
  
  sudo install -o root -g root -m 0755 \
  bin/vm-doc-server \
  /opt/vm-doc-server/bin/vm-doc-server
  
  
  sudo systemctl start vm-doc-server
sudo systemctl status vm-doc-server --no-pager -l
