python3 - <<'PY'
from pathlib import Path

path = Path("internal/database/database.go")
text = path.read_text()

old = "collation=utf8mb4_unicode_ci&multiStatements=true"
new = "collation=utf8mb4_unicode_ci&multiStatements=true&interpolateParams=true"

if old not in text:
    if new in text:
        print("interpolateParams este deja activat")
    else:
        raise SystemExit("DSN-ul așteptat nu a fost găsit")
else:
    path.write_text(text.replace(old, new, 1))
    print("interpolateParams=true adăugat")
PY
