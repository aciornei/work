python3 - <<'PY'
from pathlib import Path

path = Path("internal/config/config_test.go")
text = path.read_text()

old = '''\
\t\tOpenAPI:   OpenAPIConfig{SwaggerPath: "/docs/"},
\t}
\treturn cfg
}
'''

new = '''\
\t\tOpenAPI:   OpenAPIConfig{SwaggerPath: "/docs/"},
\t}
\tapplyDefaults(&cfg)
\treturn cfg
}
'''

if old not in text:
    raise SystemExit("Blocul cautat nu a fost gasit; fisierul nu a fost modificat.")

path.write_text(text.replace(old, new, 1))
print("config_test.go reparat")
PY
